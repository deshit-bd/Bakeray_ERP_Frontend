"use client";

import { useEffect, useMemo, useState } from "react";
import TableImportDialog from "./LazyTableImportDialog";
import { useTableImport } from "../hooks/useTableImport";
import { getNextPrefixedId, parseNumericValue } from "../utils/tableImport";

export const CUSTOMER_ORDERS_STORAGE_KEY = "erp-customer-orders";
const SALES_STORAGE_KEY = "erp-sales-rows";
const INVOICES_STORAGE_KEY = "erp-invoice-rows";

export const salesRows = [];

export const invoiceRows = [];

const salesImportColumns = [
  { key: "id", label: "ID", required: false, aliases: ["Sales ID"] },
  { key: "items", label: "Product Items", aliases: ["Items", "Item Count"] },
  { key: "companyName", label: "Company Name", aliases: ["Customer Name", "Customer"] },
  { key: "status", label: "Status", required: false },
  { key: "barcode", label: "bar code", required: false, aliases: ["Barcode"] },
];

const invoiceImportColumns = [
  { key: "id", label: "ID", required: false, aliases: ["Invoice ID"] },
  { key: "items", label: "Items", aliases: ["Product Items"] },
  { key: "companyName", label: "Company Name", aliases: ["Customer Name", "Customer"] },
  { key: "customerCategory", label: "Customer Category", required: false, aliases: ["Category"] },
  { key: "invoiceDate", label: "Invoice Date", required: false, aliases: ["Date"] },
  { key: "status", label: "Status", required: false },
  { key: "total", label: "Total", required: false, aliases: ["Total Amount", "Amount"] },
  { key: "paid", label: "Paid", required: false, aliases: ["Paid Amount"] },
  { key: "balanceDue", label: "Balance Due", required: false, aliases: ["Due Amount", "Due"] },
];

export const fallbackCustomerOrders = [];

function SearchIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      className="h-4 w-4"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      strokeLinecap="round"
      strokeLinejoin="round"
    >
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.5-3.5" />
    </svg>
  );
}

function ExportIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      className="h-4 w-4"
      fill="none"
      stroke="currentColor"
      strokeWidth="1.9"
      strokeLinecap="round"
      strokeLinejoin="round"
    >
      <path d="M12 3v10" />
      <path d="m8 9 4 4 4-4" />
      <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
    </svg>
  );
}

function ChevronIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      className="h-4 w-4"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      strokeLinecap="round"
      strokeLinejoin="round"
    >
      <path d="m9 6 6 6-6 6" />
    </svg>
  );
}

function statusChipClass(status) {
  if (status === "Complete") {
    return "bg-[#dcfce7] text-[#16a34a]";
  }

  return "bg-[#fff1e8] text-[#f97316]";
}

function invoiceStatusClass(status) {
  if (status === "Paid") {
    return "bg-[#dcfce7] text-[#16a34a]";
  }

  return "bg-[#fff1e8] text-[#f97316]";
}

function formatInvoiceAmount(amount) {
  return `TK ${Number(amount || 0).toLocaleString()}`;
}

function formatOrderAmount(amount) {
  return `TK ${Number(amount || 0).toFixed(2)}`;
}

export default function SalesPosManagement() {
  const [salesData, setSalesData] = useState(salesRows);
  const [invoiceData, setInvoiceData] = useState(invoiceRows);
  const [salesSearch, setSalesSearch] = useState("");
  const [invoiceSearch, setInvoiceSearch] = useState("");
  const [salesFilter, setSalesFilter] = useState("ALL");
  const [invoiceFilter, setInvoiceFilter] = useState("ALL");
  const [isInvoiceModalOpen, setIsInvoiceModalOpen] = useState(false);
  const [viewingInvoice, setViewingInvoice] = useState(null);
  const [customerOrders, setCustomerOrders] = useState(fallbackCustomerOrders);
  const [viewingOrder, setViewingOrder] = useState(null);
  const [invoiceForm, setInvoiceForm] = useState({
    companyName: "",
    customerName: "",
    customerCategory: "Wholeseller",
    totalBill: "",
    getAmount: "",
    discount: "",
    vat: "",
  });

  useEffect(() => {
    if (typeof window === "undefined") {
      return;
    }

    try {
      const stored = window.localStorage.getItem(CUSTOMER_ORDERS_STORAGE_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed) && parsed.length > 0) {
          setCustomerOrders(parsed);
        }
      }

      const storedSales = window.localStorage.getItem(SALES_STORAGE_KEY);
      if (storedSales) {
        const parsedSales = JSON.parse(storedSales);
        if (Array.isArray(parsedSales) && parsedSales.length > 0) {
          setSalesData(parsedSales);
        }
      }

      const storedInvoices = window.localStorage.getItem(INVOICES_STORAGE_KEY);
      if (storedInvoices) {
        const parsedInvoices = JSON.parse(storedInvoices);
        if (Array.isArray(parsedInvoices) && parsedInvoices.length > 0) {
          setInvoiceData(parsedInvoices);
        }
      }
    } catch {}
  }, []);

  useEffect(() => {
    if (typeof window !== "undefined") {
      window.localStorage.setItem(SALES_STORAGE_KEY, JSON.stringify(salesData));
    }
  }, [salesData]);

  useEffect(() => {
    if (typeof window !== "undefined") {
      window.localStorage.setItem(INVOICES_STORAGE_KEY, JSON.stringify(invoiceData));
    }
  }, [invoiceData]);

  const filteredSales = useMemo(() => {
    return salesData.filter((item) => {
      const matchesSearch = [item.id, item.companyName, item.items, item.status, item.barcode]
        .join(" ")
        .toLowerCase()
        .includes(salesSearch.toLowerCase());

      const matchesFilter =
        salesFilter === "ALL" ||
        (salesFilter === "Pending" && item.status === "Pending") ||
        (salesFilter === "Complete" && item.status === "Complete");

      return matchesSearch && matchesFilter;
    });
  }, [salesData, salesSearch, salesFilter]);

  const filteredInvoices = useMemo(() => {
    return invoiceData.filter((item) => {
      const matchesSearch = [item.id, item.companyName, item.items, item.amount, item.totalAmount, item.dueAmount, item.status]
        .join(" ")
        .toLowerCase()
        .includes(invoiceSearch.toLowerCase());

      const matchesFilter =
        invoiceFilter === "ALL" ||
        (invoiceFilter === "ABC" && item.companyName === "ABC") ||
        (invoiceFilter === "BUT" && item.companyName === "BUT") ||
        (invoiceFilter === "CVF" && item.companyName === "CVF");

      return matchesSearch && matchesFilter;
    });
  }, [invoiceData, invoiceSearch, invoiceFilter]);


  const {
    inputRef: salesImportInputRef,
    isDialogOpen: isSalesImportDialogOpen,
    isLoading: isSalesImportLoading,
    errorMessage: salesImportErrorMessage,
    fileName: salesImportFileName,
    preview: salesImportPreview,
    openFilePicker: openSalesImportFilePicker,
    handleFileChange: handleSalesImportFileChange,
    closeDialog: closeSalesImportDialog,
    confirmImport: confirmSalesImport,
  } = useTableImport({
    columns: salesImportColumns,
    existingRows: salesData,
    transformRow: (row, { index, existingRows }) => ({
      id: row.id || getNextPrefixedId(existingRows, "SA", "id", index),
      items: parseNumericValue(row.items) || 1,
      companyName: row.companyName || "",
      status: row.status || "Pending",
      barcode: row.barcode || "",
    }),
    onApply: setSalesData,
  });

  const {
    inputRef: invoiceImportInputRef,
    isDialogOpen: isInvoiceImportDialogOpen,
    isLoading: isInvoiceImportLoading,
    errorMessage: invoiceImportErrorMessage,
    fileName: invoiceImportFileName,
    preview: invoiceImportPreview,
    openFilePicker: openInvoiceImportFilePicker,
    handleFileChange: handleInvoiceImportFileChange,
    closeDialog: closeInvoiceImportDialog,
    confirmImport: confirmInvoiceImport,
  } = useTableImport({
    columns: invoiceImportColumns,
    existingRows: invoiceData,
    transformRow: (row, { index, existingRows }) => {
      const total = parseNumericValue(row.total);
      const paid = parseNumericValue(row.paid);
      const balanceDue = row.balanceDue ? parseNumericValue(row.balanceDue) : Math.max(total - paid, 0);
      return {
        id: row.id || getNextPrefixedId(existingRows, "IN", "id", index),
        items: parseNumericValue(row.items) || 1,
        companyName: row.companyName || "",
        customerCategory: row.customerCategory || "Wholeseller",
        invoiceDate: row.invoiceDate || new Date().toISOString().slice(0, 10),
        status: row.status || (balanceDue <= 0 ? "Paid" : "Partial"),
        description: [{ name: row.companyName || "Imported Item", amount: total }],
        subtotal: total,
        discount: 0,
        tax: 0,
        total,
        paid,
        balanceDue,
      };
    },
    onApply: setInvoiceData,
  });

  const handleInvoiceChange = (field, value) => {
    setInvoiceForm((current) => ({ ...current, [field]: value }));
  };

  const closeInvoiceModal = () => {
    setIsInvoiceModalOpen(false);
    setInvoiceForm({
      companyName: "",
      customerName: "",
      customerCategory: "Wholeseller",
      totalBill: "",
      getAmount: "",
      discount: "",
      vat: "",
    });
  };

  const getQrValue = (invoice) => {
    if (!invoice) {
      return "";
    }

    return [
      `Invoice: ${invoice.id}`,
      `Company: ${invoice.companyName}`,
      `Date: ${invoice.invoiceDate}`,
      `Total: ${invoice.total}`,
      `Paid: ${invoice.paid}`,
      `Due: ${invoice.balanceDue}`,
    ].join(" | ");
  };

  const openOrderDetails = (salesItem) => {
    const matchedOrder = customerOrders.find(
      (order) => order.customerName === salesItem.companyName
    );

    setViewingOrder(
      matchedOrder || {
        id: salesItem.id,
        customerName: salesItem.companyName,
        orderDate: "",
        items: [],
        receivedAmount: "0",
      }
    );
  };

  const viewingOrderTotal = useMemo(() => {
    if (!viewingOrder?.items) {
      return 0;
    }

    return viewingOrder.items.reduce(
      (sum, item) => sum + Number(item.quantity || 0) * Number(item.unitPrice || 0),
      0
    );
  }, [viewingOrder]);

  const viewingOrderPaid = Number(viewingOrder?.receivedAmount || 0);
  const viewingOrderDue = Math.max(viewingOrderTotal - viewingOrderPaid, 0);

  return (
    <section className="min-w-0 flex-1 bg-[#f7f9fc] p-3 sm:p-4 lg:p-6 xl:p-8">
      <div className="mx-auto max-w-[1280px]">
        <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <div>
            <h1 className="text-[28px] font-semibold tracking-[-0.02em] text-[#0f172a]">
              Sales
            </h1>
            <p className="mt-1 text-[15px] text-[#64748b]">
              Track and manage stock across warehouses
            </p>
          </div>

          <button
            type="button"
            onClick={openSalesImportFilePicker}
            className="inline-flex h-10 items-center justify-center gap-2 self-start rounded-[10px] border border-[#d5dce8] bg-white px-4 text-[14px] font-medium text-[#344054] transition hover:bg-[#f8fbff]"
          >
            <ExportIcon />
            Export
          </button>
          <input ref={salesImportInputRef} type="file" accept=".xlsx,.xls,.csv" className="hidden" onChange={handleSalesImportFileChange} />
        </div>

        <div
          className="mt-4 rounded-[12px] border px-4 py-4 text-[16px] font-medium"
          style={{
            borderColor: "var(--sales-ready-border)",
            background: "var(--sales-ready-bg)",
            color: "var(--sales-ready-text)",
          }}
        >
          3 items are ready for sales
        </div>

        <div className="mt-4 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div className="relative w-full max-w-[560px]">
            <span className="pointer-events-none absolute inset-y-0 left-4 flex items-center text-[#98a2b3]">
              <SearchIcon />
            </span>
            <input
              type="text"
              value={salesSearch}
              onChange={(event) => setSalesSearch(event.target.value)}
              placeholder="Search sales by ID, product, company, barcode, invoice, or status..."
              className="h-11 w-full rounded-[12px] border border-[#cddcf2] bg-white pl-11 pr-4 text-[14px] text-[#111827] outline-none placeholder:text-[#98a2b3] focus:border-[#93b4ff]"
            />
          </div>

          <div className="relative">
            <select
              value={salesFilter}
              onChange={(event) => setSalesFilter(event.target.value)}
              className="h-10 appearance-none rounded-[8px] border border-[#cfd5dd] bg-[#d9d9d9] px-5 pr-10 text-[13px] font-medium text-[#666] outline-none focus:border-[#93b4ff]"
            >
              <option value="ALL">ALL</option>
              <option value="Pending">Pending</option>
              <option value="Complete">Complete</option>
            </select>
            <span className="pointer-events-none absolute inset-y-0 right-4 flex items-center text-[#666]">
              <ChevronIcon />
            </span>
          </div>
        </div>

        <div className="mt-4 overflow-hidden rounded-[18px] border border-[#dfe5ef] bg-white shadow-[0_10px_30px_rgba(15,23,42,0.05)]">
          <div className="overflow-x-auto">
            <table className="min-w-[980px] w-full border-separate border-spacing-0">
              <thead>
                <tr className="bg-[#f9fafb]">
                  {[
                    "ID",
                    "Product Items",
                    "Company Name",
                    "Order Details",
                    "Invoice",
                    "Status",
                    "bar code",
                  ].map((header) => (
                    <th
                      key={header}
                      className="border-b border-[#e4e7ec] px-4 py-4 text-left text-[13px] font-semibold text-[#475467] first:rounded-tl-[18px] last:rounded-tr-[18px]"
                    >
                      {header}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {filteredSales.map((item) => (
                  <tr key={item.id} className="bg-white">
                    <td className="border-b border-[#eaecf0] px-4 py-4 text-[14px] font-semibold text-[#2347ff]">
                      {item.id}
                    </td>
                    <td className="border-b border-[#eaecf0] px-4 py-4 text-[14px] text-[#344054]">
                      {item.items}
                    </td>
                    <td className="border-b border-[#eaecf0] px-4 py-4 text-[14px] font-semibold text-[#2347ff]">
                      {item.companyName}
                    </td>
                    <td className="border-b border-[#eaecf0] px-4 py-4">
                      <button
                        type="button"
                        onClick={() => openOrderDetails(item)}
                        className="text-[14px] font-medium text-[#2347ff] underline-offset-2 hover:underline"
                      >
                        View
                      </button>
                    </td>
                    <td className="border-b border-[#eaecf0] px-4 py-4">
                      {item.status !== "Complete" ? (
                        <button
                          type="button"
                          onClick={() => setIsInvoiceModalOpen(true)}
                          className="inline-flex h-8 items-center justify-center rounded-[6px] bg-[#2d30ff] px-4 text-[12px] font-medium text-white hover:bg-[#2326e6]"
                        >
                          Create
                        </button>
                      ) : null}
                    </td>
                    <td className="border-b border-[#eaecf0] px-4 py-4">
                      <span
                        className={[
                          "inline-flex rounded-full px-3 py-1 text-[12px] font-medium",
                          statusChipClass(item.status),
                        ].join(" ")}
                      >
                        {item.status}
                      </span>
                    </td>
                    <td className="border-b border-[#eaecf0] px-4 py-4 text-[14px] text-[#344054]">
                      {item.barcode}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div className="mt-10 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <div>
            <h2 className="text-[28px] font-semibold tracking-[-0.02em] text-[#0f172a]">
              Invoice History
            </h2>
            <p className="mt-1 text-[15px] text-[#64748b]">
              Track and manage stock across warehouses
            </p>
          </div>

          <button
            type="button"
            onClick={openInvoiceImportFilePicker}
            className="inline-flex h-10 items-center justify-center gap-2 self-start rounded-[10px] border border-[#d5dce8] bg-white px-4 text-[14px] font-medium text-[#344054] transition hover:bg-[#f8fbff]"
          >
            <ExportIcon />
            Export
          </button>
          <input ref={invoiceImportInputRef} type="file" accept=".xlsx,.xls,.csv" className="hidden" onChange={handleInvoiceImportFileChange} />
        </div>

        <div className="mt-4 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div className="relative w-full max-w-[560px]">
            <span className="pointer-events-none absolute inset-y-0 left-4 flex items-center text-[#98a2b3]">
              <SearchIcon />
            </span>
            <input
              type="text"
              value={invoiceSearch}
              onChange={(event) => setInvoiceSearch(event.target.value)}
              placeholder="Search invoices by invoice ID, product, company, amount, due, or status..."
              className="h-11 w-full rounded-[12px] border border-[#cddcf2] bg-white pl-11 pr-4 text-[14px] text-[#111827] outline-none placeholder:text-[#98a2b3] focus:border-[#93b4ff]"
            />
          </div>

          <div className="relative">
            <select
              value={invoiceFilter}
              onChange={(event) => setInvoiceFilter(event.target.value)}
              className="h-10 appearance-none rounded-[8px] border border-[#cfd5dd] bg-[#d9d9d9] px-5 pr-10 text-[13px] font-medium text-[#666] outline-none focus:border-[#93b4ff]"
            >
              <option value="ALL">ALL</option>
              <option value="ABC">ABC</option>
              <option value="BUT">BUT</option>
              <option value="CVF">CVF</option>
            </select>
            <span className="pointer-events-none absolute inset-y-0 right-4 flex items-center text-[#666]">
              <ChevronIcon />
            </span>
          </div>
        </div>

        <div className="mt-4 overflow-hidden rounded-[18px] border border-[#dfe5ef] bg-white shadow-[0_10px_30px_rgba(15,23,42,0.05)]">
          <div className="overflow-x-auto">
            <table className="min-w-[900px] w-full border-separate border-spacing-0">
              <thead>
                <tr className="bg-[#f9fafb]">
                  {["ID", "Items", "Company Name", "Invoice Details"].map((header) => (
                    <th
                      key={header}
                      className="border-b border-[#e4e7ec] px-4 py-4 text-left text-[13px] font-semibold text-[#475467] first:rounded-tl-[18px] last:rounded-tr-[18px]"
                    >
                      {header}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {filteredInvoices.map((item) => (
                  <tr key={item.id} className="bg-white">
                    <td className="border-b border-[#eaecf0] px-4 py-4 text-[14px] font-semibold text-[#2347ff]">
                      {item.id}
                    </td>
                    <td className="border-b border-[#eaecf0] px-4 py-4 text-[14px] text-[#344054]">
                      {item.items}
                    </td>
                    <td className="border-b border-[#eaecf0] px-4 py-4 text-[14px] font-semibold text-[#2347ff]">
                      {item.companyName}
                    </td>
                    <td className="border-b border-[#eaecf0] px-4 py-4">
                      <button
                        type="button"
                        onClick={() => setViewingInvoice(item)}
                        className="text-[14px] font-medium text-[#2347ff] underline-offset-2 hover:underline"
                      >
                        View
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <TableImportDialog
        title="Import Sales Data"
        columns={salesImportColumns}
        isOpen={isSalesImportDialogOpen}
        isLoading={isSalesImportLoading}
        errorMessage={salesImportErrorMessage}
        fileName={salesImportFileName}
        preview={salesImportPreview}
        onClose={closeSalesImportDialog}
        onConfirm={confirmSalesImport}
      />

      <TableImportDialog
        title="Import Invoice Data"
        columns={invoiceImportColumns}
        isOpen={isInvoiceImportDialogOpen}
        isLoading={isInvoiceImportLoading}
        errorMessage={invoiceImportErrorMessage}
        fileName={invoiceImportFileName}
        preview={invoiceImportPreview}
        onClose={closeInvoiceImportDialog}
        onConfirm={confirmInvoiceImport}
      />

      <div
        className={[
          "fixed inset-0 z-40 flex items-center justify-center bg-[#0f172a]/30 p-4 backdrop-blur-[2px] transition",
          isInvoiceModalOpen ? "pointer-events-auto opacity-100" : "pointer-events-none opacity-0",
        ].join(" ")}
      >
        <div className="w-full max-w-[460px] rounded-[20px] bg-white p-4 shadow-[0_30px_80px_rgba(15,23,42,0.2)] sm:p-5">
          <div className="flex items-start justify-between gap-4">
            <h3 className="text-[18px] font-semibold text-[#111827]">Create Invoice</h3>

            <button
              type="button"
              onClick={closeInvoiceModal}
              className="grid h-9 w-9 place-items-center rounded-full text-[#344054] transition hover:bg-[#f8fafc]"
              aria-label="Close invoice form"
            >
              <svg
                viewBox="0 0 24 24"
                className="h-5 w-5"
                fill="none"
                stroke="currentColor"
                strokeWidth="2"
                strokeLinecap="round"
              >
                <path d="M6 6l12 12" />
                <path d="M18 6 6 18" />
              </svg>
            </button>
          </div>

          <form className="mt-5">
            <div className="grid gap-3">
              <label className="block">
                <span className="mb-2 block text-[13px] font-medium text-[#111827]">
                  Company Name
                </span>
                <input
                  type="text"
                  value={invoiceForm.companyName}
                  onChange={(event) => handleInvoiceChange("companyName", event.target.value)}
                  placeholder="Enter company name"
                  className="h-10 w-full rounded-[10px] border border-[#d9e2ef] px-4 text-[14px] text-[#111827] outline-none placeholder:text-[#98a2b3] focus:border-[#2f66e3]"
                />
              </label>

              <div className="grid gap-3 sm:grid-cols-2">
                <label className="block">
                  <span className="mb-2 block text-[13px] font-medium text-[#111827]">
                    Customer Name
                  </span>
                  <input
                    type="text"
                    value={invoiceForm.customerName}
                    onChange={(event) => handleInvoiceChange("customerName", event.target.value)}
                    placeholder="Enter contact name"
                    className="h-10 w-full rounded-[10px] border border-[#d9e2ef] px-4 text-[14px] text-[#111827] outline-none placeholder:text-[#98a2b3] focus:border-[#2f66e3]"
                  />
                </label>

                <label className="block">
                  <span className="mb-2 block text-[13px] font-medium text-[#111827]">
                    Select Customer category
                  </span>
                  <select
                    value={invoiceForm.customerCategory}
                    onChange={(event) =>
                      handleInvoiceChange("customerCategory", event.target.value)
                    }
                    className="h-10 w-full rounded-[10px] border border-[#d9e2ef] bg-white px-4 text-[14px] text-[#111827] outline-none focus:border-[#2f66e3]"
                  >
                    <option>Wholeseller</option>
                    <option>Retailer</option>
                    <option>General</option>
                  </select>
                </label>
              </div>

              <div className="grid gap-3 sm:grid-cols-2">
                <label className="block">
                  <span className="mb-2 block text-[13px] font-medium text-[#111827]">
                    Total Bill
                  </span>
                  <input
                    type="number"
                    value={invoiceForm.totalBill}
                    onChange={(event) => handleInvoiceChange("totalBill", event.target.value)}
                    className="h-10 w-full rounded-[10px] border border-[#d9e2ef] px-4 text-[14px] text-[#111827] outline-none focus:border-[#2f66e3]"
                  />
